# Site agent (chat widget): Anthropic API key from console.anthropic.com. Without it the widget shows a "leave a message" fallback.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Zapier / GoHighLevel / Airtable webhook. Leads always go to the Formspree inbox; this adds a copy.
LEADS_WEBHOOK_URL=

# Client app (/app). Create a free project at supabase.com, run supabase/schema.sql in its SQL editor, then paste these from Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Comma separated. These emails sign in as the studio owner (admin view).
ADMIN_EMAILS=
